rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {

      // Account marker
      allow read, write: if owns(uid);

      // Monthly data
      match /months/{monthKey} {
        allow read: if owns(uid);
        allow create, update, delete: if owns(uid);
      }

      // Savings / debt ledger
      match /meta/{docId} {
        allow read, write: if owns(uid);
      }

      // Legacy car data - read only
      match /carMonths/{monthKey} {
        allow read: if owns(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}